# Copy this file to .env.local and fill in your real values.
# Restart `npm run dev` after changing any value (NEXT_PUBLIC_* values are inlined at build time).

# Phone number in E.164 format: +1 followed by 10 digits, no spaces or dashes.
NEXT_PUBLIC_PHONE_NUMBER=+15555550123

# Production URL with no trailing slash (used for canonical URLs, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.example.com

NEXT_PUBLIC_AGENCY_NAME=Your Agency Name
NEXT_PUBLIC_LICENSE_NUMBER=Lic. #0000000

# Optional analytics (leave blank to disable). Scripts load with strategy="afterInteractive".
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Optional: paste the verification code from Google Search Console (HTML tag method).
NEXT_PUBLIC_GSC_VERIFICATION=
